{
  "name": "piparser",
  "version": "0.0.16",
  "author": "Basil Gass",
  "license": "MIT",
  "description": "A simple parser for the PI language",
  "type": "module",
  "main": "dist/piparser.js",
  "module": "dist/piparser.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/piparser.js",
      "require": "./dist/piparser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --p ./tsconfig-build.json && vite build",
    "preview": "vite preview",
    "dependency-cruise": "dependency-cruise -T dot -x node_modules -v -- src/index.ts  | dot -T svg > dependencies.svg"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basilgass/PiParser.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/eslint__js": "^8.42.3",
    "dependency-cruiser": "^16.4.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite": "^6.2.6",
    "vite-plugin-dts": "^4.0.3",
    "vitest": "^3.1.1"
  }
}
